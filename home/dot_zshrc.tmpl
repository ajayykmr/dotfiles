# ~/.zshrc: interactive shells only. Environment variables that scripts and
# non-interactive shells need belong in ~/.zshenv instead.
#
# Managed by chezmoi. Edit with `chezmoi edit ~/.zshrc`.
# Machine-specific or work-only config goes in ~/.zshrc.local (not tracked).

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ── PATH and completions ────────────────────────────────────────────────────
# Set here, not in ~/.zshenv: on macOS, /etc/zprofile (path_helper) runs after
# ~/.zshenv in login shells and would reorder it. Must come before Oh My Zsh,
# which runs compinit and only sees completions already on fpath.

# Keep path and fpath free of duplicates, e.g. when a shell is started from
# another shell. This only applies to array assignments (path=(...)), not to
# `export PATH=...`, so the entries below use the array form.
typeset -U path fpath

{{ if eq .chezmoi.os "darwin" -}}
# Homebrew: bin, sbin, man pages and completions (site-functions on fpath).
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

{{ end -}}
path=("$HOME/.local/bin" $path)
command -v go >/dev/null && path+=("$(go env GOPATH)/bin")

# pyenv: from Homebrew, or a git clone in ~/.pyenv
export PYENV_ROOT="$HOME/.pyenv"
[[ -d "$PYENV_ROOT/bin" ]] && path=("$PYENV_ROOT/bin" $path)
if command -v pyenv >/dev/null; then
  eval "$(pyenv init - --no-rehash)"
fi

# Docker CLI completions
[[ -d "$HOME/.docker/completions" ]] && fpath=("$HOME/.docker/completions" $fpath)

# zsh-completions is added to fpath instead of plugins=(), because as a plugin
# it loads after compinit and its completions never register.
fpath+=("$HOME/.oh-my-zsh/custom/plugins/zsh-completions/src")

# ── fzf ─────────────────────────────────────────────────────────────────────
# Ctrl+R history, Ctrl+T file path, Alt+C cd into a subfolder.
if (( $+commands[fd] )); then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
fi
(( $+commands[bat] )) && export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:300 {}'"

# ── Oh My Zsh ───────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
zstyle ':omz:update' mode reminder  # just remind me to update when it's time

# sudo:              Esc Esc puts sudo in front of the current/last command
# extract:           `extract <archive>` unpacks any archive type
# copypath/copyfile: copy the current path / a file's contents to the clipboard
plugins=(git kubectl sudo extract colored-man-pages copypath copyfile)
# Only when the tool is installed, so a missing one can't print warnings.
(( $+commands[fzf] )) && plugins+=(fzf fzf-tab)  # fzf-tab: Tab opens a fuzzy list
(( $+commands[zoxide] )) && plugins+=(zoxide)    # `z <part of path>` jumps there
# These wrap zle widgets, so they go last and in this order: autosuggestions,
# syntax-highlighting, then history-substring-search (type part of a command,
# Up/Down cycle through matching history).
plugins+=(zsh-autosuggestions zsh-syntax-highlighting history-substring-search)

# Fixed dump name: the default includes $HOST, which can change between
# networks and forces a full compinit rebuild.
ZSH_COMPDUMP="$HOME/.zcompdump"

source $ZSH/oh-my-zsh.sh

# History in ~/.zsh_history. Oh My Zsh keeps only 10,000 entries in the file
# and deletes older ones. 100,000 is years of history at normal use and keeps
# startup fast (every shell reads the whole file). HISTSIZE (in memory) is a
# bit larger so hist_expire_dups_first drops duplicates before unique entries.
HISTSIZE=120000
SAVEHIST=100000

# fzf-tab: let fzf replace the completion menu, show group names, < > switch
# groups, and preview folders when completing cd or z.
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:complete:(cd|__zoxide_z):*' fzf-preview 'ls -1 --color=always $realpath'

# history-substring-search binds Up/Down via terminfo; also bind the plain
# escape codes some terminals send.
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

{{ if eq .chezmoi.os "darwin" -}}
test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

{{ end -}}
# ── Prompt ──────────────────────────────────────────────────────────────────
# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# p10k overrides, safe from `p10k configure` regeneration
unset POWERLEVEL9K_KUBECONTEXT_SHOW_ON_COMMAND
typeset -g POWERLEVEL9K_OS_ICON_BACKGROUND=235  # dark charcoal
typeset -g POWERLEVEL9K_OS_ICON_FOREGROUND=228  # light yellow
typeset -g POWERLEVEL9K_DIR_BACKGROUND=25       # dark blue
typeset -g POWERLEVEL9K_DIR_FOREGROUND=255      # pure white
typeset -g POWERLEVEL9K_KUBECONTEXT_DEFAULT_BACKGROUND=54   # deep purple
typeset -g POWERLEVEL9K_KUBECONTEXT_DEFAULT_FOREGROUND=225  # pale lavender-white

# ── Keys ────────────────────────────────────────────────────────────────────
bindkey '^[[1;3C' forward-word   # Alt+Right
bindkey '^[[1;3D' backward-word  # Alt+Left

# ── Aliases ─────────────────────────────────────────────────────────────────
alias chx='chmod +x'
alias kctx=kubectx
alias kns=kubens
# cat with syntax highlighting, otherwise plain like cat. `bat` for line numbers and paging.
(( $+commands[bat] )) && alias cat='bat --paging=never --style=plain'

# ── Local overrides ─────────────────────────────────────────────────────────
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
